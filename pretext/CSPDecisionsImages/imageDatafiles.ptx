<section xml:id="csp-decisions-images_image-datafiles">
  <title>Datafiles for Using Decisions with Images</title>

  <p>
    This section contains datafiles for using decisions with images.
  </p>
  <datafile label="fr-flag" filename="fr-flag.gif">
    <image source="CSP/Images/fr-flag.gif">
      <shortdescription>Flag of France.</shortdescription>
    </image>
  </datafile>
  <datafile label="be-flag" filename="be-flag.gif">
    <image source="CSP/Images/be-flag.gif">
      <shortdescription>Flag of Belgium.</shortdescription>
    </image>
  </datafile>
  <datafile label="cd-flag" filename="cd-flag.gif">
    <image source="CSP/Images/cd-flag.gif">
      <shortdescription>Flag of the Democratic Republic of the Congo.</shortdescription>
    </image>
  </datafile>
  <datafile label="beach" filename="beach.jpg">
    <image source="CSP/Images/beach.jpg">
      <shortdescription>Beach scene used as a sample image.</shortdescription>
    </image>
  </datafile>
</section>